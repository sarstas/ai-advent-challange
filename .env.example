# ============================================================
#  Скопируй этот файл в .env и впиши свой ключ:
#      cp .env.example .env
#  .env в .gitignore — секреты в репозиторий не попадают.
# ============================================================

# --- DeepSeek API ---
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120

# --- Backend (Go) ---
PORT=8080
DATABASE_URL=postgres://aiadvent:aiadvent@localhost:5432/aiadvent?sslmode=disable

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=aiadvent
POSTGRES_USER=aiadvent
POSTGRES_PASSWORD=aiadvent
POSTGRES_PORT=5432
